{
  "server": {
    "host": "${GATEWAY_HOST:-127.0.0.1}",
    "port": 8790,
    "api_key": "${API_KEY:-}",
    "auto_compact": true
  },
  "ollama": {
    "url": "${OLLAMA_URL:-http://127.0.0.1:11434}",
    "pinned": [
      "bge-m3"
    ]
  },
  "llamacpp": {
    "server_binary": "${LLAMA_SERVER}",
    "port": 8791,
    "startup_timeout_s": 300,
    "log_dir": "logs"
  },
  "agent": {
    "workspaces": [
      "${PROJECTS_DIR}"
    ],
    "data_dir": "data",
    "sandbox": "k8s",
    "k8s": {
      "agents_dir": "data/agents",
      "namespace": "llm-agents",
      "image": "llm-gateway-agent:latest",
      "kube_context": "${KUBE_CONTEXT:-docker-desktop}",
      "cpu": "2",
      "memory": "2Gi"
    },
    "default_mode": "default",
    "max_steps": 40,
    "hooks": {},
    "mcp_servers": {},
    "max_running": 1
  },
  "profiles": [
    {
      "id": "qwen3-8b-agent",
      "name": "Qwen3 8B · 32K",
      "backend": "ollama",
      "model": "qwen3:8b",
      "context": 32768,
      "tools": true,
      "notes": "Agent profile: a larger context for tool results."
    },
    {
      "id": "qwen3-8b",
      "name": "Qwen3 8B · 8K",
      "backend": "ollama",
      "model": "qwen3:8b",
      "context": 8192,
      "max_context": 40960,
      "type": "dense",
      "size_gb": 5.2,
      "speed_tps": 58.4,
      "speed_zh_tps": 58.5,
      "quant": "Q4_K_M",
      "bits": 5.1,
      "params_b": 8.19,
      "placement": "gpu",
      "notes": "Fits fully in a 12 GB GPU."
    },
    {
      "id": "gemma4-26b-qat-moe",
      "name": "Gemma 4 26B-A4B QAT (MoE offload) · 8K",
      "backend": "llamacpp",
      "model_path": "${GGUF_DIR}/gemma4-26b-a4b-it-qat.gguf",
      "context": 8192,
      "max_context": 262144,
      "type": "moe",
      "size_gb": 15,
      "speed_tps": 45.0,
      "speed_zh_tps": 45.1,
      "quant": "Q4_0 (QAT)",
      "bits": 4.58,
      "params_b": 25.23,
      "placement": "gpu+cpu",
      "args": [
        "-ngl",
        "99",
        "-ncmoe",
        "11"
      ],
      "notes": "11 layers of experts on CPU, the rest on the GPU."
    }
  ]
}
