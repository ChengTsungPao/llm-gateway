# Machine-specific values for config.json (copy to .env and edit; .env is not committed).
# config.json refers to them as ${NAME} or ${NAME:-default}. Real environment variables win over this file.

# Network
GATEWAY_HOST=127.0.0.1            # 0.0.0.0 to reach the gateway from a phone (LAN / Tailscale)
# OLLAMA_URL=http://host.docker.internal:11434   # set to override Ollama URL (e.g. inside Docker)
API_KEY=                          # set one before exposing the gateway beyond this machine

# Model files
LLAMA_SERVER=/path/to/llama-server          # llama.cpp server binary
GGUF_DIR=/path/to/gguf                      # folder with downloaded .gguf files
OLLAMA_BLOBS=/path/to/ollama/models/blobs   # Ollama's blob folder (llama.cpp profiles can load these)

# Agent
PROJECTS_DIR=/path/to/your/projects         # folders the web agent may work in (local sandbox)
KUBE_CONTEXT=docker-desktop                 # Kubernetes context for agent pods
# HOST_DATA_DIR=D:/program/Github/llm-gateway/data  # Host path to data/ folder for K8s agent pod mounts when running in Docker

# Time zone of the "today" job counters on the Models page (Docker defaults to UTC)
# TZ=Asia/Taipei
